{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci-agent/governance/schemas/intake_schema.schema.json",
  "title": "Intake questionnaire definition",
  "description": "Validates catalog/intake_schema.yaml — the structured definition of what must be asked during project intake (CI-Agent Production Architecture Report, Section 2 customer inputs and Section 14 intake table).",
  "type": "object",
  "required": ["version", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of the questionnaire definition itself."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "questions"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                  "enum": ["string", "enum", "boolean", "integer", "number", "string_list"]
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "enum"
                      }
                    },
                    "required": ["type"]
                  },
                  "then": {
                    "required": ["options"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
