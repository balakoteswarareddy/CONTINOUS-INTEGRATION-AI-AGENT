{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci-agent/governance/schemas/stage_template.schema.json",
  "title": "Planner stage template",
  "description": "Validates planner/templates/*.yaml — the per-stack Phase A stage -> tool mapping (CI-Agent Production Architecture Report, Section 5.1 Phase A stages; Section 13 Phase 1 templates). Loaded via ci_agent.governance.validate_against_schema.",
  "type": "object",
  "required": ["stack", "stages"],
  "additionalProperties": false,
  "properties": {
    "stack": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Language/stack key matched against ProjectProfile.language_stack."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "tool_name",
          "tool_version",
          "command_template_id",
          "timeout_seconds",
          "retryable",
          "max_retries"
        ],
        "additionalProperties": false,
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "description": "External tool name, or internal.<gate> for Section 5.1 control-flow stages."
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "container_image": {
            "type": ["string", "null"],
            "description": "Pinned container image, or null for gates/checkout."
          },
          "command_template_id": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "retryable": {
            "type": "boolean"
          },
          "max_retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "resource_limits": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
