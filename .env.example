# CI Agent environment template.
# Copy to `.env` and populate real values only when needed. Never commit real
# secrets (CI-Agent Production Architecture Report, Section 7).

# Runtime environment: local | dev | prod
CI_AGENT_ENV=local

# Database URL (Batch 2 audit store). SQLAlchemy generic URLs only; SQLite for
# local dev, swap to Postgres in deployment without code changes.
# DATABASE_URL=sqlite:///./ci_agent.db

# GitHub webhook HMAC secret (Batch 2 ingress). REQUIRED in dev/prod — startup
# fails loudly if unset there. In `local` only, the documented dev default
# "ci-agent-local-dev-webhook-secret" is used so the stack boots out of the box.
# GITHUB_WEBHOOK_SECRET=

# Open Policy Agent endpoint (Batch 3 Policy Decision Point). Default:
# http://localhost:8181 (the docker-compose `opa` service).
# OPA_URL=http://localhost:8181
# OPA evaluation timeout in seconds (Report Section 10 "Timeouts"; default 5).
# OPA_TIMEOUT_SECONDS=5

# --- GitHub runner adapter (Batch 4) -------------------------------------
# MVP credential options (preferred first). Full workload-identity/OIDC
# hardening of this credential is a pre-production hardening item (NOTES.md).
# Option A: GitHub App (preferred)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/secure/path/to/app-private-key.pem
# GITHUB_INSTALLATION_ID=
# Option B: fine-grained PAT (documented MVP fallback)
# GITHUB_PAT=

# --- Admin API (Batch 5, MVP-grade static key control) --------------------
# REQUIRED in dev/prod. In `local` only, the documented dev default
# "ci-agent-local-admin-key" applies. Proper admin authn/authz is a
# hardening item (NOTES.md).
# ADMIN_API_KEY=

# --- Backpressure (Batch 5, Section 10 concurrency quotas) ----------------
# MAX_CONCURRENT_RUNS_PER_PROJECT=3

# --- GitLab CI runner adapter (Batch 8) -----------------------------------
# REQUIRED in dev/prod when the GitLab adapter is registered (fail-loud in
# GitLabClient). Local-dev ONLY placeholder so the stack boots out of the box;
# never use this value against a real GitLab instance.
# GITLAB_ACCESS_TOKEN=ci-agent-local-dev-gitlab-token
# API base URL; defaults to gitlab.com SaaS.
# GITLAB_BASE_URL=https://gitlab.com/api/v4

# --- GitLab webhook (Batch 8) ----------------------------------------------
# Shared secret sent by GitLab as the X-Gitlab-Token header, compared in
# constant time. UNSET (recommended in local) → the endpoint answers 401 to
# EVERYTHING (fail closed); dev/prod deployments that register the GitLab
# webhook MUST set it. Local-dev placeholder:
# GITLAB_WEBHOOK_TOKEN=ci-agent-local-dev-gitlab-webhook

# --- Jenkins runner adapter (Batch 8, polling-only) ------------------------
# All three REQUIRED in dev/prod when the Jenkins adapter is registered
# (fail-loud in JenkinsClient). No Jenkins webhook exists — completion is
# observed by reconciliation polling (NOTES.md Batch 8). Local-dev
# placeholders:
# JENKINS_URL=ci-agent-local-dev-jenkins
# JENKINS_USER=ci-agent-local-dev-jenkins-user
# JENKINS_API_TOKEN=ci-agent-local-dev-jenkins-token

# --- AI model gateway (Batch 9, Section 13 Phase 4) ------------------------
# Which model provider the gateway registers. DEFAULT noop = no model is ever
# called: the platform (and all four AI-assisted features) are fully
# functional with zero API keys via deterministic fallbacks. Enabling a
# provider ALSO requires admitting it in the governed
# governance/catalog/policies/ai_policy.yaml (deny-by-default: no provider is
# admitted) — an env var alone enables nothing. Valid: noop | openai | anthropic.
# AI_PROVIDER=noop

# Per-request token budget for model calls (max_tokens sent to the provider
# and the prompt-truncation heuristic). Default 4096.
# MODEL_TOKEN_BUDGET=4096

# Provider credentials are read from the standard variables below when a
# provider is enabled. NEVER logged, NEVER persisted — every invocation is
# recorded in ai_invocation_records as sha256 prompt/response HASHES only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
